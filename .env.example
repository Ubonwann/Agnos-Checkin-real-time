# Pusher Channels (Dashboard -> App Keys)
# https://dashboard.pusher.com
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=
# The client needs the key & cluster too, hence the NEXT_PUBLIC_ copies.
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=

# Upstash Redis (used for the session store; REST-based so it works from
# Vercel's serverless functions). If you add the Upstash integration from
# the Vercel Marketplace, these two are populated for you automatically.
# https://console.upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
